# Copy to .env only for local development; blank keys become random ephemeral keys.
# Production: configure these securely in the hosting environment, never commit .env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./bcms_dev.db
DEBUG=false
SECRET_KEY=
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local-only seeding requires a separate password of at least 12 characters.
DEMO_USER_PASSWORD=
