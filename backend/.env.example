# Django reads process variables, not this file automatically.
# Local shell: DEBUG=true; omit DATABASE_URL to use SQLite.
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a unique local password before explicit demo provisioning; never use in production.
DEMO_USER_PASSWORD=
# Production requires ENVIRONMENT=production, DEBUG=false, DATABASE_URL and strong SECRET_KEY.
# Optional initial admin variables: see docs/LOGIN_TUZATISH.md; never place values in Git.
